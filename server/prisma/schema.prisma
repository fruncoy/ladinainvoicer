// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Invoice {
  id          String   @id @default(cuid())
  invoiceNo   String
  billedTo    String
  date        String
  currency    String   @default("USD")
  total       Float
  status      String   @default("draft")
  lineItems   Json     // Storing line items as JSON
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Receipt {
  id          String   @id @default(cuid())
  receiptNo   String
  invoiceId   String
  amount      Float
  date        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BankDetails {
  id               String   @id @default("current")
  bankName         String
  bankCode         String?
  branch           String?
  accountName      String
  accountNumberUSD String?
  accountNumberKES String?
  swiftCode        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
